# Acuan penerapan HTTPS LELANGIKAN.ID (NFR-04: TLS 1.2 atau lebih tinggi).
# Berkas ini contoh untuk server TPI (mini PC, Debian/Ubuntu). Salin ke
# /etc/nginx/sites-available/sipeli lalu `ln -s` ke sites-enabled.
#
# Sertifikat: gunakan sertifikat dari CA internal TPI, atau CA publik bila server
# dijangkau dari luar. Perintah membuat sertifikat uji internal:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout /etc/ssl/private/sipeli.key -out /etc/ssl/certs/sipeli.crt \
#     -subj "/CN=sipeli.tpi.local" -addext "subjectAltName=DNS:sipeli.tpi.local"

server {
    listen 80;
    server_name sipeli.tpi.local;
    # Semua permintaan biasa dialihkan ke HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name sipeli.tpi.local;

    ssl_certificate     /etc/ssl/certs/sipeli.crt;
    ssl_certificate_key /etc/ssl/private/sipeli.key;

    # Hanya TLS 1.2 dan 1.3 (NFR-04).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    # HSTS: hanya nyalakan bila sertifikat sudah dipercaya seluruh perangkat TPI.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    root /var/www/lelangikan/sipeli-backend/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Kanal real-time (Laravel Reverb) di server yang sama.
    location /app/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /apps/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ /\.(?!well-known) { deny all; }
}
